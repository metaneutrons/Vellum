{
  "name": "vellum",
  "version": "1.23.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/metaneutrons/Vellum.git"
  },
  "homepage": "https://github.com/metaneutrons/Vellum",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env scripts/check-pending-migrations.mjs && next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0 && pnpm brand:check && node scripts/check-theme-tokens.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "brand:check": "node scripts/check-brand-assets.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest --run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "i18n:check": "node scripts/check-i18n.mjs",
    "release:check": "node scripts/check-release-config.mjs && node scripts/check-security-layouts.mjs",
    "db:check": "node scripts/check-schema-migrations.mjs && node scripts/check-schema-snapshot.mjs && node scripts/check-db-access.mjs",
    "prepare": "lefthook install",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.mjs",
    "dev:mdns": "node scripts/mdns-announce.mjs & pnpm dev",
    "mdns": "node scripts/mdns-announce.mjs"
  },
  "dependencies": {
    "@azure/identity": "4.13.2",
    "@azure/msal-node": "5.6.0",
    "@date-fns/tz": "1.5.0",
    "@microsoft/microsoft-graph-client": "3.0.7",
    "@napi-rs/canvas": "1.0.8",
    "@tailwindcss/postcss": "4.3.3",
    "date-fns": "4.4.0",
    "drizzle-orm": "0.45.2",
    "esp-web-tools": "^10.4.0",
    "lucide-react": "^1.34.0",
    "multicast-dns": "^7.2.5",
    "next": "16.3.3",
    "next-intl": "4.14.0",
    "openid-client": "^6.8.7",
    "pg": "8.23.0",
    "postcss": "8.5.26",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-rnd": "^10.5.3",
    "tailwindcss": "4.3.3",
    "undici": "8.10.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.2",
    "@types/node": "26.2.0",
    "@types/pg": "8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitest/coverage-v8": "4.1.11",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.3",
    "eslint-plugin-react-hooks": "7.1.1",
    "fast-check": "4.9.0",
    "jsdom": "30.0.1",
    "lefthook": "^2.1.12",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.11"
  }
}
