{
  "name": "vellum",
  "version": "1.11.2",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/metaneutrons/Vellum.git"
  },
  "homepage": "https://github.com/metaneutrons/Vellum",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest --run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "i18n:check": "node scripts/check-i18n.mjs",
    "release:check": "node scripts/check-release-config.mjs",
    "db:check": "node scripts/check-schema-migrations.mjs && node scripts/check-db-access.mjs",
    "prepare": "node scripts/setup-git-hooks.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.mjs",
    "dev:mdns": "node scripts/mdns-announce.mjs & next dev",
    "mdns": "node scripts/mdns-announce.mjs"
  },
  "dependencies": {
    "@azure/identity": "4.13.1",
    "@azure/msal-node": "5.5.0",
    "@date-fns/tz": "1.5.0",
    "@microsoft/microsoft-graph-client": "3.0.7",
    "@napi-rs/canvas": "1.0.3",
    "@tailwindcss/postcss": "4.3.3",
    "date-fns": "4.4.0",
    "drizzle-orm": "0.45.2",
    "esp-web-tools": "^10.4.0",
    "lucide-react": "^1.29.0",
    "multicast-dns": "^7.2.5",
    "next": "16.3.0",
    "next-intl": "4.13.5",
    "openid-client": "^6.8.4",
    "pg": "8.22.0",
    "postcss": "8.5.26",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-rnd": "^10.5.3",
    "tailwindcss": "4.3.3",
    "undici": "8.10.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@types/node": "26.2.0",
    "@types/pg": "8.21.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitest/coverage-v8": "4.1.10",
    "drizzle-kit": "0.31.10",
    "eslint": "10.8.1",
    "eslint-config-next": "16.3.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "fast-check": "4.9.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.66.0",
    "vitest": "4.1.10"
  }
}
