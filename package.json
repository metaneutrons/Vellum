{
  "name": "vellum",
  "version": "1.24.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/metaneutrons/Vellum.git"
  },
  "homepage": "https://github.com/metaneutrons/Vellum",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env scripts/check-pending-migrations.mjs && next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0 && pnpm brand:check && node scripts/check-theme-tokens.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "brand:check": "node scripts/check-brand-assets.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest --run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "i18n:check": "node scripts/check-i18n.mjs",
    "release:check": "node scripts/check-release-config.mjs && node scripts/check-security-layouts.mjs",
    "db:check": "node scripts/check-schema-migrations.mjs && node scripts/check-schema-snapshot.mjs && node scripts/check-db-access.mjs",
    "prepare": "if git rev-parse --git-dir > /dev/null 2>&1; then lefthook install; fi",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.mjs",
    "dev:mdns": "node scripts/mdns-announce.mjs & pnpm dev",
    "mdns": "node scripts/mdns-announce.mjs"
  },
  "dependencies": {
    "@azure/msal-node": "7.2.3",
    "@date-fns/tz": "1.5.0",
    "@microsoft/microsoft-graph-client": "3.1.0",
    "@napi-rs/canvas": "1.1.1",
    "@tailwindcss/postcss": "4.3.5",
    "date-fns": "4.4.0",
    "drizzle-orm": "0.45.4",
    "esp-web-tools": "^10.5.2",
    "lucide-react": "^1.76.0",
    "multicast-dns": "^7.2.5",
    "next": "16.4.6",
    "next-intl": "4.15.1",
    "openid-client": "^6.9.0",
    "pg": "8.23.1",
    "postcss": "8.5.33",
    "qrcode": "^1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-rnd": "^10.5.3",
    "tailwindcss": "4.3.5",
    "undici": "8.12.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.1.1",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "eslint-plugin-react-hooks": "7.1.1",
    "fast-check": "4.11.0",
    "jsdom": "31.0.1",
    "lefthook": "^2.2.2",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.1"
  }
}
