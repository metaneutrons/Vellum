# ── Dependencies ──────────────────────────────────────────────
# No trailing slash, deliberately. A pattern ending in "/" matches DIRECTORIES
# only, so a SYMLINK named node_modules is a file and slips past it. That is not
# hypothetical: working in a git worktree means symlinking node_modules to the main
# checkout, `git add -A` then tracked the link, and every CI job died on
# "ENOTDIR: not a directory, mkdir .../node_modules" because a file stood where
# pnpm wanted a directory.
node_modules

# ── Next.js ───────────────────────────────────────────────────
.next/
out/

# ── Environment & Secrets ─────────────────────────────────────
.env*
deploy/vellum.env
deploy/.vellum/
deploy/data/
*.pem
*.key
*.der
vellum-firmware-signing.key
# KMS / HSM signing configs may hold PINs or credentials — commit only *.example.
hsm_config.ini
kmsp11.yaml
# Public key material and eFuse digests ARE committed (public, needed to verify /
# rotate): keys/*.pub and keys/*digest*.bin are safe — they are not secrets.

# ── Build artifacts ───────────────────────────────────────────
/build
/coverage

# ── ESP-IDF Firmware (E-series) ───────────────────────────────
firmware/build/
firmware/sdkconfig
firmware/sdkconfig.old
firmware/sdkconfig.panel
firmware/dependencies.lock
firmware/managed_components/
firmware/version.txt

# ── ESP-IDF Firmware (D1001) ──────────────────────────────────
firmware-d1001/build/
firmware-d1001/sdkconfig
firmware-d1001/sdkconfig.old
firmware-d1001/dependencies.lock
firmware-d1001/managed_components/

# ── OS / Editor ───────────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# ── Debug logs ────────────────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ── TypeScript ────────────────────────────────────────────────
*.tsbuildinfo
next-env.d.ts

# ── Misc ──────────────────────────────────────────────────────
.vercel
.kiro/

# Runtime serial-device artifacts written by dev tooling
data/

# Temporary output of scripts/check-schema-snapshot.mjs (must be a repo-relative
# path because drizzle-kit prefixes --out with "./"); removed after each run.
.drizzle-parity-*/
