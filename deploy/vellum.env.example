# Save the configured copy as `.env` next to `docker-compose.yml`, restrict it
# to the account that operates Vellum, and replace every placeholder below.

# Release assets replace both `latest` tags with their exact vX.Y.Z release
# tag. The updater verifies and deploys later server versions independently;
# updating the updater itself remains an explicit stack maintenance operation.
VELLUM_IMAGE=ghcr.io/metaneutrons/vellum:latest
UPDATER_IMAGE=ghcr.io/metaneutrons/vellum-updater:latest

POSTGRES_DB=vellum
POSTGRES_USER=vellum
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql://vellum:replace-with-a-long-random-password@postgres:5432/vellum

ENCRYPTION_KEY=replace-with-openssl-rand-hex-32
SESSION_SECRET=replace-with-openssl-rand-hex-32
ADMIN_API_KEY=replace-with-openssl-rand-hex-32
ADMIN_USER=admin
ADMIN_PASS=replace-with-a-long-random-password
NODE_ENV=production
VELLUM_PUBLIC_URL=https://vellum.example.com

# Shared only between Vellum and the updater's internal control API.
# Generate with: openssl rand -hex 32
UPDATER_TOKEN=replace-with-openssl-rand-hex-32
TZ=Europe/Berlin
# Initial defaults used until the update behavior is first saved in the Web UI.
AUTO_APPLY=true
MAINTENANCE_TIME=02:00

# Optional Entra ID OIDC
# ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
# ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
# ENTRA_CLIENT_SECRET=replace-with-the-client-secret

# Optional GitHub token for a higher Releases API rate limit. The public API
# works without one at the default four checks per hour.
# GITHUB_TOKEN=github_pat_read_only
