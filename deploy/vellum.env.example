# `install.sh` fills this in for you — it generates every secret, writes the file
# as 0600, and starts the stack. Configure it by hand only if you are not using
# the installer; in that case replace EVERY placeholder below with an
# independently generated value (`openssl rand -hex 32`), save the file as `.env`
# next to `docker-compose.yml`, and `chmod 600` it.
#
# The placeholders are not merely advisory: they are the same length as real
# secrets, and the server and updater both reject the shipped text outright rather
# than boot with secrets that are public repository content.

# Release assets replace both `latest` tags with their exact vX.Y.Z release
# tag. The updater verifies and deploys later server versions independently;
# updating the updater itself remains an explicit stack maintenance operation.
VELLUM_IMAGE=ghcr.io/metaneutrons/vellum:latest
UPDATER_IMAGE=ghcr.io/metaneutrons/vellum-updater:latest

POSTGRES_DB=vellum
POSTGRES_USER=vellum
# Keep this URL-safe (no @ : / % #) — docker-compose.yml interpolates it into the
# connection string.
POSTGRES_PASSWORD=replace-with-a-long-random-password

# DATABASE_URL is derived from POSTGRES_* by docker-compose.yml, so the password
# is defined once. Uncomment only to point Vellum at a database outside this
# stack; a value here overrides the derived one.
# DATABASE_URL=postgresql://user:password@db.example.com:5432/vellum

ENCRYPTION_KEY=replace-with-openssl-rand-hex-32
SESSION_SECRET=replace-with-openssl-rand-hex-32
ADMIN_API_KEY=replace-with-openssl-rand-hex-32
ADMIN_USER=admin
ADMIN_PASS=replace-with-a-long-random-password
NODE_ENV=production
VELLUM_PUBLIC_URL=https://vellum.example.com

# Shared only between Vellum and the updater's internal control API.
# Generate with: openssl rand -hex 32
UPDATER_TOKEN=replace-with-openssl-rand-hex-32
TZ=Europe/Berlin
# Initial defaults used until the update behavior is first saved in the Web UI.
AUTO_APPLY=true
# Let the update service replace itself after a healthy server update. It cannot
# recreate its own container directly, so a detached one-shot helper performs the
# swap, verifies the new container and rolls back if it does not come up. Off by
# default; see docs/DOCKER_DEPLOYMENT.md.
AUTO_UPDATE_UPDATER=false
MAINTENANCE_TIME=02:00

# Optional Entra ID OIDC
# ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
# ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
# ENTRA_CLIENT_SECRET=replace-with-the-client-secret

# Optional GitHub token for a higher Releases API rate limit. The public API
# works without one at the default four checks per hour.
# GITHUB_TOKEN=github_pat_read_only
