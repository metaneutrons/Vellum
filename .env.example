# Vellum — Environment Variables
# Copy to .env and fill in all values.

# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/vellum

# Master encryption key for calendar provider credentials at rest.
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=change-me-generate-with-openssl-rand-hex-32

# Secret used to sign admin session cookies (HMAC-SHA256). Min 32 chars.
# Generate with: openssl rand -hex 32. Rotating it logs out all admins.
SESSION_SECRET=change-me-generate-with-openssl-rand-hex-32

# Admin API key — minimum 32 characters
ADMIN_API_KEY=change-me-to-a-random-string-at-least-32-chars

# Admin dashboard login credentials
ADMIN_USER=admin
ADMIN_PASS=change-me-at-least-8-chars

# Optional Microsoft Entra ID OIDC (single tenant). The client secret belongs
# in your deployment secret store, never in Git. Set one canonical HTTPS origin;
# Vellum owns the callback path and derives it deterministically.
# Canonical public origin. Optional, but three things depend on it: the Origin
# check on admin mutation endpoints, whether OTA downloads are proxied by Vellum
# instead of GitHub, and Entra OIDC redirects. Behind a reverse proxy, leave it
# set — without it the Origin check falls back to comparing the request Host,
# which works but no longer verifies the scheme.
# VELLUM_PUBLIC_URL=https://vellum.example.com
# Register exactly: https://vellum.example.com/api/auth/oidc/entra/callback
# ENTRA_TENANT_ID=4d966e13-b7ac-47b6-a82c-22f07889951a
# ENTRA_CLIENT_ID=your-vellum-app-client-id
# ENTRA_CLIENT_SECRET=store-this-in-your-secret-manager

# Optional: "development" | "production" | "test" (default: development)
NODE_ENV=development

# Optional: "debug" | "info" | "warn" | "error" (default: info)
LOG_LEVEL=info
