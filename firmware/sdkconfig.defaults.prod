# ============================================================================
# Vellum Firmware — PRODUCTION HARDENING PROFILE (top of the ladder)
# ============================================================================
#
# The THIRD and final rung. Apply ONLY after `testsecure` and `secureboot` are
# proven on spare/sacrificial boards:
#
#   make build MODEL=e1002 SECURE=1 SECURE_PROFILE=prod
# or directly:
#   idf.py -DSDKCONFIG_DEFAULTS="sdkconfig.defaults.s3;sdkconfig.defaults.prod" build
#
# ⚠️  POINT OF NO RETURN: enabling Secure Boot v2 AND Flash Encryption (Release)
#     causes the bootloader to BURN eFuses on first boot. After that the board can
#     only run firmware signed with your Secure Boot key, JTAG/ROM-download are
#     locked, and flash is encrypted with a per-device key. There is NO undo and
#     NO UART recovery. Validate the full image + OTA flow on dev boards first.
#
# See docs/SECURE_BOOT_AND_KMS.md for the complete provisioning runbook.
# ----------------------------------------------------------------------------

# ── Partition table moved to clear the larger signed bootloader ─────────────
# (Same secure layout as sdkconfig.defaults.secureboot — factory-flash-only.)
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.secure.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x10000

# ── Secure Boot v2 (verified boot chain) ───────────────────────────────────
CONFIG_SECURE_BOOT=y
CONFIG_SECURE_BOOT_V2_ENABLED=y
CONFIG_SECURE_SIGNED_APPS_RSA_SCHEME=y
# Remote/HSM/KMS signing — no Secure Boot private key on the build host. The
# bootloader is signed offline at provisioning; app images are signed in CI with
# `espsecure.py sign_data --version 2 --hsm`. (Was BUILD_SIGNED_BINARIES=y with a
# local keys/secure_boot_signing_key.pem — replaced by KMS custody in Phase 3.)
CONFIG_SECURE_BOOT_BUILD_SIGNED_BINARIES=n
CONFIG_VELLUM_SECURITY_PROFILE="production"
CONFIG_VELLUM_NVS_HMAC_INTEGRITY=y
# Do not allow JTAG once secure boot is on.
CONFIG_SECURE_BOOT_ALLOW_JTAG=n

# ── Flash Encryption (Release mode — production) ────────────────────────────
CONFIG_SECURE_FLASH_ENC_ENABLED=y
CONFIG_SECURE_FLASH_ENCRYPTION_MODE_RELEASE=y
# Lock down the UART/ROM download path so an attacker can't read/write flash.
CONFIG_SECURE_FLASH_UART_BOOTLOADER_ALLOW_ENC=n
CONFIG_SECURE_FLASH_UART_BOOTLOADER_ALLOW_DEC=n
CONFIG_SECURE_FLASH_UART_BOOTLOADER_ALLOW_CACHE=n
CONFIG_SECURE_DISABLE_ROM_DL_MODE=y

# ── NVS Encryption (credentials at rest) ────────────────────────────────────
# With Flash Encryption enabled, the nvs_key partition (see partitions.csv) is
# itself protected by flash encryption, so the standard flash-enc key scheme
# gives real at-rest confidentiality for the WiFi PSK, device token and the
# X25519 private key.
CONFIG_NVS_ENCRYPTION=y
CONFIG_NVS_SEC_KEY_PROTECT_USING_FLASH_ENC=y

# ── Anti-rollback (block downgrade to older signed images) ──────────────────
# Complements the app-level OTA signature: a validly-signed but OLDER image is
# rejected once the secure version has advanced (eFuse-backed counter).
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
CONFIG_BOOTLOADER_APP_ANTI_ROLLBACK=y
CONFIG_BOOTLOADER_APP_SECURE_VERSION=1
CONFIG_BOOTLOADER_APP_SEC_VER_SIZE_EFUSE_FIELD=32

# ── OTA image signature required (fail-closed) ──────────────────────────────
# Redundant with the Kconfig default (now y) but pinned here so a production
# build can never accidentally ship fail-open.
CONFIG_VELLUM_OTA_REQUIRE_SIGNATURE=y

# ── Reduce log verbosity / info leakage in the field ────────────────────────
CONFIG_LOG_DEFAULT_LEVEL_WARN=y
CONFIG_BOOTLOADER_LOG_LEVEL_WARN=y
