menu "Vellum Configuration"

    config VELLUM_FIRMWARE_VERSION
        string "Firmware version"
        default "1.4.6" # x-release-please-version

    config VELLUM_DEFAULT_SERVER_URL
        string "Default server URL"
        default "https://vellum.local"

    choice VELLUM_DISPLAY_PANEL
        prompt "Display panel"
        default VELLUM_PANEL_GDEP073E01
        config VELLUM_PANEL_GDEY075T7
            bool "E1001 — GDEY075T7 (7.5\" BW, 800x480)"
        config VELLUM_PANEL_GDEP073E01
            bool "E1002 — GDEP073E01 (7.3\" 6-Color, 800x480)"
        config VELLUM_PANEL_E1003
            bool "E1003 — 10.3\" 16-Gray, 1404x1872"
        config VELLUM_PANEL_D1001
            bool "D1001 — 8\" LCD MIPI-DSI, 800x1280"
    endchoice

    config VELLUM_DISPLAY_MODEL
        string
        default "e1001" if VELLUM_PANEL_GDEY075T7
        default "e1002" if VELLUM_PANEL_GDEP073E01
        default "e1003" if VELLUM_PANEL_E1003
        default "d1001" if VELLUM_PANEL_D1001

    config VELLUM_DISPLAY_IS_LCD
        bool
        default y if VELLUM_PANEL_D1001
        default n

    menu "Hardware Pins (reTerminal E Series)"
        config VELLUM_BUTTON_KEY0_GPIO
            int "KEY0 GPIO (Right/Green — refresh)"
            default 3
        config VELLUM_BUTTON_KEY1_GPIO
            int "KEY1 GPIO (Middle — report)"
            default 4
        config VELLUM_BUTTON_KEY2_GPIO
            int "KEY2 GPIO (Left — SoftAP hold)"
            default 5
        config VELLUM_BUTTON_ACTIVE_HIGH
            bool "Button active HIGH (D1001)"
            default y if VELLUM_PANEL_D1001
            default n
        config VELLUM_LED_GPIO
            int "Status LED GPIO (inverted)"
            default 6
        config VELLUM_BUZZER_GPIO
            int "Buzzer GPIO"
            default 45
        config VELLUM_BATTERY_ADC_GPIO
            int "Battery ADC GPIO"
            default 1
        config VELLUM_BATTERY_EN_GPIO
            int "Battery monitoring enable GPIO"
            # The E1003 routes the battery monitor enable to GPIO40. GPIO21 is
            # ITE_VCC_EN on that board and must never be driven as VBAT_EN.
            default 40 if VELLUM_PANEL_E1003
            default 21
    endmenu

    menu "Timing"
        config VELLUM_BATTERY_CRITICAL_PERCENT
            int "Critical battery shutdown threshold (%)"
            default 5
            range 1 20
        config VELLUM_FALLBACK_SLEEP_SEC
            int "Fallback sleep duration (seconds)"
            default 900
            range 60 7200
        config VELLUM_ERROR_BACKOFF_MAX_SEC
            int "Maximum retry delay after consecutive render failures (seconds)"
            default 3600
            range 0 86400
            help
                Ceiling for the retry ladder walked after failed render cycles;
                a successful cycle resets the streak. The ladder itself comes
                from the assigned refresh profile (X-Error-Backoff), or from a
                built-in default until the server has answered once. This is only
                the device-side clamp, for an operator who wants a tighter bound
                than the server's. 0 disables the clamp, not the backoff.
        config VELLUM_WIFI_CONNECT_TIMEOUT_MS
            int "Wi-Fi connection timeout (ms)"
            default 30000
            range 5000 60000
        config VELLUM_WIFI_MAX_RETRIES
            int "Wi-Fi connection max retries"
            default 3
            range 1 10
        config VELLUM_HTTP_TIMEOUT_MS
            int "HTTP request timeout (ms)"
            default 30000
            range 5000 60000
    endmenu

    config VELLUM_OTA_SIGNING_PUBKEY
        string "Primary Ed25519 OTA signing public key (raw 32 bytes, base64)"
        default "sdY80/jyxvaEuXOHjs8qb5hyDdf3petsG+JjlSYZJmc="
        help
            Raw 32-byte Ed25519 public key, base64-encoded (NOT DER/PEM).
            The server signs the 32-byte SHA-256 digest of each firmware image
            with the matching private key; the device verifies that signature.
            This is the PRIMARY trust anchor. During a planned key rotation the
            successor goes in VELLUM_OTA_SIGNING_PUBKEY_NEXT first, then gets
            promoted here.

    config VELLUM_OTA_SIGNING_KEY_ID
        string "Primary OTA key id"
        default "vellum-ota-2026a"
        help
            Stable label for the primary key. CI stamps the signing key's id into
            the manifest (otaKeyId) so the device can (a) fast-path the matching
            key and (b) name it in OTA telemetry. Not security-relevant — a wrong
            id only costs a fallback over the whole trust store.

    config VELLUM_OTA_SIGNING_PUBKEY_NEXT
        string "Next Ed25519 OTA signing public key (raw 32 bytes, base64)"
        default ""
        help
            Reserved slot for a rotation successor. Leave EMPTY until a rotation
            is staged. When set, the device trusts this key too, so a later
            release can start signing with it without a fleet-wide cutover. An
            empty value makes the slot inert. See the Secure Boot / KMS runbook.

    config VELLUM_OTA_SIGNING_KEY_ID_NEXT
        string "Next OTA key id"
        default ""
        help
            Stable label for the reserved "next" key. Only meaningful once
            VELLUM_OTA_SIGNING_PUBKEY_NEXT is populated.

    config VELLUM_OTA_REVOKED_KEY_IDS
        string "Comma-separated revoked OTA key ids"
        default ""
        help
            Emergency revocation list. Any trusted key whose id appears here (as a
            whole comma-separated token) is refused even though its public key is
            still compiled in. Push a hotfix — signed by a still-trusted key —
            that adds a compromised key's id here to lock it out fleet-wide.

    config VELLUM_OTA_REQUIRE_SIGNATURE
        bool "Require a valid OTA signature (fail-closed)"
        default y
        help
            When set (default y, fail-closed), OTA updates without a valid Ed25519
            signature are rejected. With any signing key in the trust store a valid
            signature is ALWAYS required; this knob additionally governs the no-key
            case — accepting unsigned firmware requires BOTH this set to n AND
            VELLUM_OTA_ALLOW_UNSIGNED=y. With Secure Boot disabled this app-level
            signature is the ONLY control preventing malicious firmware, so leave it
            at y for any device that leaves the bench.

    config VELLUM_OTA_ALLOW_UNSIGNED
        bool "Allow unsigned OTA when no signing key is configured (DANGEROUS)"
        default n
        help
            When set AND VELLUM_OTA_SIGNING_PUBKEY is empty, the device accepts
            firmware images that carry no Ed25519 signature. With Secure Boot
            disabled this removes the ONLY control preventing malicious firmware,
            so it is strictly for local development. Leave at n (fail-closed) for
            any device that leaves the bench — NEVER enable in production.

    config VELLUM_OTA_MIN_BATTERY_PCT
        int "Minimum battery % to start an OTA (when not USB-powered)"
        default 35
        range 0 100
        help
            OTA updates are skipped when running on battery below this level, so a
            brownout mid-flash cannot corrupt the staged image and brick the
            device. Ignored when the device is on USB power.

endmenu
