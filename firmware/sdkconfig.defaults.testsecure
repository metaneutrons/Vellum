# ============================================================================
# Vellum Firmware — SIGNED-VERIFY PROFILE (no eFuse, fully reversible)
# ============================================================================
#
# The FIRST rung of the Secure Boot ladder. The bootloader verifies the app's
# RSA-3072 signature but NOTHING is burned to eFuse — Secure Boot is NOT enabled.
# Use this to prove the full sign -> OTA -> verify chain on a spare board before
# any irreversible step. A board flashed with this profile stays a normal,
# reflashable dev board.
#
# Apply to any supported Vellum model via the SECURE=1 Makefile knob:
#   make build MODEL=e1002 SECURE=1 SECURE_PROFILE=testsecure
# or directly:
#   idf.py -DSDKCONFIG_DEFAULTS="sdkconfig.defaults.s3;sdkconfig.defaults.testsecure" build
#
# See docs/SECURE_BOOT_AND_KMS.md for the full runbook.
# ----------------------------------------------------------------------------

# Require signed app images WITHOUT hardware Secure Boot (no eFuse burn).
CONFIG_SECURE_SIGNED_APPS_NO_SECURE_BOOT=y
# ESP32-S3 Secure Boot v2 uses the RSA-3072 signature scheme.
CONFIG_SECURE_SIGNED_APPS_RSA_SCHEME=y
# This reversible rung deliberately uses a LOCAL, disposable test key generated
# by the Makefile and ignored by Git. That makes the build/flash/OTA verification
# loop testable before HSM integration exists. This key has no production trust
# value and MUST NEVER be used by secureboot/prod.
CONFIG_SECURE_BOOT_BUILD_SIGNED_BINARIES=y
CONFIG_SECURE_BOOT_SIGNING_KEY="keys/testsecure_signing_key.pem"

# Attested, fully reversible runtime posture. HMAC-NVS adds a fail-closed
# integrity seal without eFuse writes; it is deliberately not represented as
# encryption or physical-tamper protection.
CONFIG_VELLUM_SECURITY_PROFILE="testsecure"
CONFIG_VELLUM_NVS_HMAC_INTEGRITY=y

# Keep the app-level Ed25519 OTA signature required as well (defense in depth).
CONFIG_VELLUM_OTA_REQUIRE_SIGNATURE=y
