# Vellum firmware — E1003 model overlay
#
# The E1003 USB-C connector terminates at a CH340K USB-to-UART bridge wired to
# ESP32-S3 UART0. It does not expose the S3's native USB-Serial-JTAG controller.
# Keep this model on UART0 so logs, the text console, and binary Improv frames
# all use the physical port selected by the browser (/dev/tty.wch* on macOS).
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
# CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG is not set
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
# CONFIG_ESP_CONSOLE_SECONDARY_USB_SERIAL_JTAG is not set
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200

# NOTE on fonts: E1003 needs glyphs larger than 48px (its 1404px short side is
# ~3x the E-Series panels, so 48px text renders at roughly a third of the
# intended optical size). There is no Kconfig switch for that — LVGL's bundled
# Montserrat stops at 48. The two larger sizes are therefore pre-generated
# assets compiled only into this model; see components/vellum_display/fonts/
# and assets/render-fonts.sh.
